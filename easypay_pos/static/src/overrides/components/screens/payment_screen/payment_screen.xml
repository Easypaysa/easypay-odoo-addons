<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="easypay_pos.PaymentScreen" t-inherit="point_of_sale.PaymentScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-summary')]//PaymentScreenPaymentLines" position="attributes">
            <attribute name="getLastTransaction.bind">getLastTransaction</attribute>
        </xpath>
        <xpath expr="//t[@t-if='ui.isSmall']//PaymentScreenPaymentLines" position="attributes">
            <attribute name="getLastTransaction.bind">getLastTransaction</attribute>
        </xpath>
    </t>

    <!-- Override PaymentScreenMethods to use grouped payment methods -->
    <t t-name="easypay_pos.PaymentScreenMethods" t-inherit="point_of_sale.PaymentScreenMethods" t-inherit-mode="extension">
        <xpath expr="//t[@t-foreach='payment_methods_from_config']" position="attributes">
            <attribute name="t-foreach">displayPaymentMethods</attribute>
        </xpath>
    </t>

</templates>