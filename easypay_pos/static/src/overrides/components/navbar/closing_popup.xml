<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    
    <t t-name="easypay_pos.ClosePosPopup" t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension" owl="1">
        <!-- Add reconciliation info before closing notes -->
        <xpath expr="//div[hasclass('closing-notes-container')]" position="before">
            <div t-if="state.reconciliation_done" class="reconciliation-info-container d-flex flex-column flex-grow-1 align-items-start mb-3">
                <div class="overview-info d-flex justify-content-between w-100 mb-2">
                    <div class="info-title">
                        <span class="fw-bold">Total Reconciled Amount:</span>
                    </div>
                    <div class="info-value">
                        <span class="fw-bold text-success" t-esc="env.utils.formatCurrency(state.reconciliation_total)"/>
                    </div>
                </div>
                <div t-if="state.reconciliation_done" class="reconciliation-status text-success">
                    <i class="fa fa-check-circle me-1"></i>
                    <span>Reconciliation completed</span>
                </div>
                <div t-if="!state.reconciliation_done" class="reconciliation-status text-warning">
                    <i class="fa fa-exclamation-triangle me-1"></i>
                    <span>Reconciliation pending</span>
                </div>
            </div>
        </xpath>

        <!-- Add reconciliation buttons as the FIRST line at the beginning -->
        <xpath expr="//div[hasclass('w-100') and hasclass('d-flex') and hasclass('flex-wrap') and hasclass('justify-content-between')]" position="before">
            <div class="reconciliation-buttons-container w-100 d-flex gap-2 mb-3 justify-content-start">
                <button class="button btn btn-warning" 
                        t-att-class="this.ui.isSmall ? 'w-100 me-2' : 'btn-lg me-2'" 
                        t-on-click="() => this.onReconciliation('reconciliation')"
                        title="Perform reconciliation">
                    <i class="fa fa-balance-scale me-1"></i>
                    <span t-if="!this.ui.isSmall">Reconciliation</span>
                    <span t-if="this.ui.isSmall">Reconcile</span>
                </button>
                <button class="button btn btn-info" 
                        t-att-class="this.ui.isSmall ? 'w-100' : 'btn-lg'" 
                        t-on-click="() => this.onReconciliation('getLastReconciliation')"
                        title="Get last reconciliation">
                    <i class="fa fa-history me-1"></i>
                    <span t-if="!this.ui.isSmall">Get Last Reconciliation</span>
                    <span t-if="this.ui.isSmall">Get Last Reconcile</span>
                </button>
            </div>
        </xpath>

        <!-- Move the first line of buttons (Close Register, Discard) to the end -->
        <xpath expr="//div[hasclass('w-100') and hasclass('d-flex') and hasclass('flex-wrap') and hasclass('justify-content-between')]//div[1]" position="replace">
            <!-- This will be moved to the end -->
        </xpath>
        
        <!-- Add the original first line buttons at the end -->
        <xpath expr="//div[hasclass('w-100') and hasclass('d-flex') and hasclass('flex-wrap') and hasclass('justify-content-between')]" position="after">
            <div t-att-class="{'col-12 col-md-6 p-0': this.ui.isSmall}" class="d-flex gap-2 mt-3">
                <button class="button highlight btn btn-primary" t-att-disabled="!canConfirm()" t-on-click="confirm" t-att-class="this.ui.isSmall ? 'w-100' : 'btn-lg'">Close Register</button>
                <button class="button btn btn-secondary" t-att-disabled="!canCancel()" t-on-click="cancel" t-att-class="this.ui.isSmall ? 'w-100' : 'btn-lg'">Discard</button>
            </div>
        </xpath>
    </t>

</templates> 