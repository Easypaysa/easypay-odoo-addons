<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="easypay_pos.PrintReconciliationReceiptScreen">
        <Dialog title="'Reconciliation Receipt'" size="'md'">
            <div class="pos-receipt-container bg-200 text-center overflow-y-auto">
                <div class="d-inline-block m-3 p-3 border rounded bg-view text-start overflow-hidden">
                    <div class="pos-receipt" t-ref="receipt">

                    </div>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="button print btn btn-lg btn-primary" t-on-click="tryReprint">
                    <i class="fa fa-print me-2"></i>
                    Print Receipt
                </button>
                <button class="button back btn btn-lg btn-secondary" t-on-click="confirm">
                    <span>Back</span>
                </button>
            </t>
        </Dialog>
    </t>

    <t t-name="easypay_pos.ReconciliationReceipt">
        <div class="pos-receipt">
          <t t-raw="dynamicContent"/>
        </div>
    </t>

</templates>
