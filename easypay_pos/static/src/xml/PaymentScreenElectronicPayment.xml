<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="PaymentScreenPaymentLines" t-inherit="point_of_sale.PaymentScreenPaymentLines" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('paymentline') and hasclass('electronic_payment')]" position="replace">
            <div class="paymentline electronic_payment">
            <t t-if="line.payment_status == 'pending'">
                <div style="line-height:30px; align-self:center;">
                    Payment request pending
                </div>
                <div class="button send_payment_request highlight" title="Send Payment Request" t-on-click="() => this.trigger('send-payment-request', line)">
                    Send
                </div>
                <t t-if="line.payment_method.use_payment_terminal == 'easypay'">
                    <div class="button send_payment_request highlight" title="Get Last Transaction" t-on-click="() => this.trigger('get-last-transaction', line)">
                        Get Last Transaction
                    </div>
                </t>
            </t>
            <t t-elif="line.payment_status == 'retry'">
                <div style="line-height:30px; align-self:center;">
                    Transaction cancelled
                </div>
                <div class="button send_payment_request highlight" title="Send Payment Request" t-on-click="() => this.trigger('send-payment-request', line)">
                    Retry
                </div>
                <t t-if="line.payment_method.use_payment_terminal == 'easypay'">
                    <div class="button send_payment_request highlight" title="Get Last Transaction" t-on-click="() => this.trigger('get-last-transaction', line)">
                        Get Last Transaction
                    </div>
                </t>
            </t>
            <t t-if="line.payment_status == 'retry'">
                <t t-if="env.pos.config.easy_force_done">
                    <!--                <div>-->
<!--                    Connection error-->
<!--                </div>-->
                    <div class="button send_force_done" style="line-height:30px; align-self:center;" title="Force Done" t-on-click="() => this.trigger('send-force-done', line)">
                        Force done
                    </div>
                </t>
            </t>
            <t t-elif="line.payment_status == 'waitingCard'">
                <div style="line-height:30px; align-self:center;">
                    Waiting for card
                </div>
                <div class="button send_payment_cancel" title="Cancel Payment Request" t-on-click="() => this.trigger('send-payment-cancel', line)">
                    Cancel
                </div>
                <t t-if="line.payment_method.use_payment_terminal == 'easypay'">
                    <div class="button send_payment_request highlight" title="Get Last Transaction" t-on-click="() => this.trigger('get-last-transaction', line)">
                        Get Last Transaction
                    </div>
                </t>
            </t>
            <t t-elif="['waiting', 'waitingCancel'].includes(line.payment_status)">
                <div>
                    Request sent
                </div>
                <div>
                    <i class="fa fa-circle-o-notch fa-spin" role="img" />
                </div>
            </t>
            <t t-elif="line.payment_status == 'reversing'">
                <div style="line-height:30px; align-self:center;">
                    Reversal request sent to terminal
                </div>
                <div>
                    <i class="fa fa-circle-o-notch fa-spin" role="img" />
                </div>
            </t>
            <t t-elif="line.payment_status == 'done'">
                <div style="line-height:30px; align-self:center;">
                    Payment Successful
                </div>
                <t t-if="env.pos.easypay_payment_method">
                <div class="button send_payment_request highlight" title="Send Payment Request" t-on-click="() => this.trigger('print-last-result')">
                    Print
                </div>
                </t>
                <t t-if="line.can_be_reversed">
                    <div class="button send_payment_reversal" title="Reverse Payment" t-on-click="() => this.trigger('send-payment-reverse', line)">
                        Reverse
                    </div>
                </t>
                <t t-else="">

                </t>
            </t>
            <t t-elif="line.payment_status == 'reversed'">
                <div style="line-height:30px; align-self:center;">
                    Payment reversed
                </div>
                <div></div>
            </t>
        </div>

        </xpath>
    </t>



</templates>
