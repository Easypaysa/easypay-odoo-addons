<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_payment_easypay_view_tree" model="ir.ui.view">
        <field name="name">pos_payment_easypay.view.tree</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="after">
                <field name="easypay_terminalid" optional="show"/>
<!--                <field name="easypay_sequence" optional="show"/>-->
            </xpath>
        </field>
    </record>
    <record id="pos_payment_easypay_view_form" model="ir.ui.view">
        <field name="name">pos_payment_easypay.view.form</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_form" />
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/group" position="after">
                <field name="payment_method_id" invisible="1"/>
                <field name="use_payment_terminal" invisible="1"/>
<!--                <group string="Easypay" name="easypay" readonly="1" attrs="{'invisible':[('use_payment_terminal','!=','easypay')]}">-->
<!--                    <field name="easypay_terminalid" />-->
<!--                    <field name="easypay_sequence" />-->
<!--                    <field name="payment_transaction_uuid" />-->
<!--                    <field name="card_number" />-->
<!--                    <field name="card_name" />-->
<!--                    <field name="entry_mode" />-->
<!--                    <field name="auth_code" />-->
<!--                    <field name="merchantid" />-->
<!--                    <field name="signature_required" />-->
<!--                    <field name="amount_paid" />-->
                    <field name="payment_log" />
<!--                </group>-->
            </xpath>
        </field>
    </record>
</odoo>