<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="pos_config_view_form_inherited" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.easypay_pos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_payment_terminals_section']" position="before">
                <block title="Easypay"  id="pos_easypay_section">
                    <field name="is_easypay" invisible="1"/> <!-- Required for control visibility of Easypay config section -->
                    <div class="col-12 col-lg-6 o_setting_box" id="easy_connection_type" invisible="not is_easypay" required="is_easypay" >
                        <div class="o_setting_right_pane">
                            <label for="easy_connection_type" />
                        </div>
                        <div class="o_setting_right_pane">
                            <field name="easy_connection_type" widget="radio"/>
                        </div>
                        </div>
                    <div class="col-12 col-lg-6 o_setting_box" id="easy_default_ip" invisible="not is_easypay" required="is_easypay">
                        <div class="o_setting_right_pane">
                            <label for="easy_default_ip" />
                        </div>
                        <div class="o_setting_right_pane">
                            <field name="easy_default_ip" />
                        </div>
                        </div>
                    <div class="col-12 col-lg-6 o_setting_box" id="easy_force_done" invisible="not is_easypay">
                        <div class="o_setting_left_pane">
                            <field name="easy_force_done" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="easy_force_done" />
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" id="enable_auto_print_payment_transaction" invisible="not is_easypay">
                        <div class="o_setting_left_pane">
                            <field name="enable_auto_print_payment_transaction" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="enable_auto_print_payment_transaction" />
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" id="print_order_receipt" invisible="not is_easypay">
                        <div class="o_setting_left_pane">
                            <field name="print_order_receipt" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="print_order_receipt" />
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" id="mandatory_reconciliation" invisible="not is_easypay">
                        <div class="o_setting_left_pane">
                            <field name="mandatory_reconciliation" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="mandatory_reconciliation" />
                        </div>
                    </div>
                </block>
            </xpath>
        </field>
    </record>
</odoo>