<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="pos_config_view_form_inherited" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.pos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='payment_methods_new']" position="after">
                <field name="is_easypay" invisible="1" />
                <div class="col-12 col-lg-6 o_setting_box" id="easy_connection_type" attrs="{'invisible': [('is_easypay', '=', False)], 'required': [('is_easypay', '=', True)]}">
                    <div class="o_setting_right_pane">
                        <label for="easy_connection_type" />
                    </div>
                    <div class="o_setting_right_pane">
                        <field name="easy_connection_type" widget="radio"/>
                    </div>
                    </div>
                <div class="col-12 col-lg-6 o_setting_box" id="easy_default_ip" attrs="{'invisible': [('is_easypay', '=', False)], 'required': [('is_easypay', '=', True)]}">
                    <div class="o_setting_right_pane">
                        <label for="easy_default_ip" />
                    </div>
                    <div class="o_setting_right_pane">
                        <field name="easy_default_ip" />
                    </div>
                    </div>
                <div class="col-12 col-lg-6 o_setting_box" id="easy_force_done" attrs="{'invisible': [('is_easypay', '=', False)]}">
                    <div class="o_setting_left_pane">
                        <field name="easy_force_done" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="easy_force_done" />
                    </div>
                    </div>
                <div class="col-12 col-lg-6 o_setting_box" id="easy_auto_validate" attrs="{'invisible': [('is_easypay', '=', False)]}">
                    <div class="o_setting_left_pane">
                        <field name="easy_auto_validate" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="easy_auto_validate" />
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box" id="enable_auto_print_payment_transaction" attrs="{'invisible': [('is_easypay', '=', False)]}">
                    <div class="o_setting_left_pane">
                        <field name="enable_auto_print_payment_transaction" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="enable_auto_print_payment_transaction" />
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>